# AI: copied from your local .env; keep all secrets server-side.
AI_ENDPOINT=https://opencode.ai/inference/v1/chat/completions
AI_API_KEY=replace-with-your-own-key
AI_MODEL=space-bunny-free
GEMINI_API_KEY=replace-with-your-own-key
GEMINI_MODEL=gemini-2.5-flash

# Supabase project URL and publishable/anon key (never service-role here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional during local development; required for shared production quotas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HMAC_SECRET=

# Per-user and global daily caps. These are hard application limits.
RATE_LIMIT_GUEST_DAILY=5
RATE_LIMIT_USER_DAILY=20
RATE_LIMIT_PER_MINUTE=3
RATE_LIMIT_ZEN_DAILY=100
RATE_LIMIT_GEMINI_DAILY=30

# `mock` uses deterministic sample reports for a safe demo without API calls.
SCAMLENS_DEMO_MODE=false
