# AI: keep all secrets server-side.
DEEPSEEK_API_KEY=replace-with-your-own-key
DEEPSEEK_MODEL=deepseek-flash
# Optional vision-capable model for image OCR; defaults to DEEPSEEK_MODEL.
DEEPSEEK_VISION_MODEL=

# JEV evaluation only; these values are read by server-side scripts, never by the browser.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-1.14.0
# Keep false until the key previously shared in chat has been revoked and replaced locally.
TYPESAFE_KEY_ROTATED=false

# Supabase project URL and publishable/anon key (never service-role here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional during local development; required for shared production quotas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HMAC_SECRET=

# Per-user and global daily caps. These are hard application limits.
RATE_LIMIT_GUEST_DAILY=20
RATE_LIMIT_USER_DAILY=60
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_DEEPSEEK_DAILY=100

# `true` uses deterministic sample reports for a safe demo without API calls.
SCAMLENS_DEMO_MODE=false
